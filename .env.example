# Niche apni real values .env.local (ya static build ke liye supabase.config.js) mein daalo.
# Static build (CDN) ke liye keys supabase.config.js mein paste hoti hain.
# Vercel/Next deploy ho to ye env vars Vercel dashboard se set karo.

# Sirf anon key — SERVICE_ROLE key kabhi bhi browser/client mein use nahi hoti.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Resend API key for contact form (server-side only)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email where contact form submissions will be sent
CONTACT_TO_EMAIL=your-email@example.com