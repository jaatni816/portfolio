{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/admin/index.html", "destination": "/admin", "permanent": true },
    { "source": "/admin/login.html", "destination": "/admin/login", "permanent": true },
    { "source": "/projects/index.html", "destination": "/projects", "permanent": true }
  ],
  "rewrites": [
    { "source": "/projects", "destination": "/projects" },
    { "source": "/projects/:slug", "destination": "/projects" },
    { "source": "/blog", "destination": "/blog" },
    { "source": "/blog/:slug", "destination": "/blog" },
    { "source": "/post/:slug", "destination": "/blog" },
    { "source": "/:slug", "destination": "/blog" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}